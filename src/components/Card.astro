---
import { projects } from "../data/projects.js";

const project = Object.entries(projects);
---

<div class="flex flex-wrap justify-center lg:flex-col gap-3">
  {
    project.map((project, index) => (
      <button
        type="button"
        class="project-card group"
        data-index={index}
        onclick={`window.dispatchEvent(
          new CustomEvent('select-project', { detail: ${index} })
        )`}
      >
        <div
          data-aos="zoom-in"
          class="
            card-inner
            relative overflow-hidden
            h-16 w-32
            lg:w-40
            lg:h-20
            flex items-center justify-center
            rounded-lg
            bg-[#32373b]
            border-l-8 border-[#c83e4d]
            text-white
            transition-colors duration-200
          "
        >
          <span
            class="
              absolute inset-0
              bg-[#c83e4d]
              w-0
              transition-all duration-300 ease-out
              group-hover:w-full
            "
          ></span>

          <span class="relative text-sm lg:text-normal truncate w-64 px-4 z-10 text-center">
            {project[1].title}
          </span>
        </div>
      </button>
    ))
  }
</div>

<script>
  const cards = document.querySelectorAll(".project-card");

  function setActive(index) {
    cards.forEach((card, i) => {
      card.classList.toggle("is-active", i === index);
    });
  }

  window.addEventListener("project-changed", (e) => {
    setActive(e.detail);
  });

  setActive(0);
</script>

<style>
  .project-card.is-active .card-inner {
    background: #c83e4d;
    color: #fff;
  }

  .project-card.is-active span.absolute {
    width: 100%;
  }
</style>
