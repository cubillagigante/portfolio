---
import StackIcons from "../components/StackIcons.astro";
import { ICONS } from "../data/icons.js";

const categories = Object.entries(ICONS);
---

<div class="grid grid-cols-1 md:grid-cols-3 w-full h-full gap-2 ">
  {
    categories.map(([categoryName, techs]) => (
      <div class="flex flex-col items-center bg-[#32373b]  rounded-lg pb-2 overflow-hidden">
        <div class="w-full bg-[#4a5859] mb-2 text-center py-2">
          <h1 class="text-xl  capitalize">{categoryName}:</h1>
        </div>
        <div class="flex flex-wrap justify-center gap-2">
          {
            techs.map((tech) => (
              <StackIcons title={tech.name}>
                <Fragment set:html={tech.svg} />
              </StackIcons>
            ))
          }
        </div>
      </div>
    ))
  }
</div>