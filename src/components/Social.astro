---
import { Icon } from "astro-icon/components";
---

<div class="fixed h-screen flex flex-col justify-evenly z-50 overflow-hidden">
  <div class="  rounded-r-xl flex flex-col">
    <!-- Botón toggle -->
    <button
      id="toggle-button"
      class="w-full flex bg-[#32373b] shadow rounded-r-lg shadow-gray-700 justify-center text-white hover:text-[#e0a53a] transition-colors duration-200"
      title="Mostrar / Ocultar"
    >
      <svg id="menu-icon" xmlns="http://www.w3.org/2000/svg" fill="currentColor" class="w-8 h-8" viewBox="0 0 24 24">
        <path d="M15.41 7.41 14 6l-6 6 6 6 1.41-1.41L10.83 12z"/>
      </svg>
    </button>

    <!-- Contenedor de links -->
    <div
      id="floating-links"
      class="mt-1 rounded-r-lg grid gap-y-2 bg-[#32373b] shadow shadow-gray-700 p-1 transform transition-all duration-300"
    >
      <a title="whatsapp" href="https://wa.me/595982229061">
        <Icon name="mdi:whatsapp" class="w-7 h-7 text-white hover:text-[#f4b860]" />
      </a>
      <a title="linkedin" href="https://www.linkedin.com/in/diego-cubilla/">
        <Icon name="mdi:linkedin" class="w-7 h-7 text-white hover:text-[#f4b860]" />
      </a>
      <a title="github" href="https://github.com/cubillagigante">
        <Icon name="mdi:github" class="w-7 h-7 text-white hover:text-[#f4b860]" />
      </a>
    </div>
  </div>
</div>

<script>
  const toggleButton = document.getElementById('toggle-button');
  const floatingLinks = document.getElementById('floating-links');
  const menuIcon = document.getElementById('menu-icon');

  let isOpen = true;

  toggleButton.addEventListener('click', () => {
    isOpen = !isOpen;

    if (isOpen) {
      floatingLinks.classList.remove('-translate-x-full', 'opacity-0');
      floatingLinks.classList.add('translate-x-0', 'opacity-100');

      // Cambiar icono (izquierda -> derecha)
      
      menuIcon.innerHTML = `<path d="M15.41 7.41 14 6l-6 6 6 6 1.41-1.41L10.83 12z"/>`;
    } else {
      floatingLinks.classList.add('-translate-x-full', 'opacity-0');
      floatingLinks.classList.remove('translate-x-0', 'opacity-100');

      // Cambiar icono (derecha -> izquierda)
      menuIcon.innerHTML = `<path d="M8.59 16.59 13.17 12 8.59 7.41 10 6l6 6-6 6z"/>`;
    }
  });
</script>
