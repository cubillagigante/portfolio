---
import Layout from "../layouts/Layout.astro";
import Social from "../components/Social.astro";
import Card from "../components/Card.astro";
import Backend from "../components/Stack.astro";
import Carousel from "../components/Carousel.vue";
import { Icon } from "astro-icon/components";
---

<Layout title="PORTFOLIO DC">
  <main>
    <Social />
    <div class="max-w-[80em] m-auto p-5">
      <section
        class="p-5 mb-5 relative rounded-xl bg-gradient-to-r from-[#ddab61] to-[#e09b32]
         before:absolute before:inset-0
         before:bg-[radial-gradient(rgba(255,255,255,0.1)_1px,transparent_0)]
         before:bg-[length:4px_4px]
         before:content-['']
         before:pointer-events-none shadow-md shadow-gray-800 text-[#32373b] font-semibold"
        data-aos="zoom-in"
      >
        <div
          class="my-4 flex flex-col lg:flex-row justify-between items-center gap-x-5"
        >
          <div class="w-full mt-4 lg:mt-0 lg:w-[70%] order-2 lg:order-1">
            <div class="flex flex-row lg:pl-10 px-4 gap-x-5 items-center">
              <div>
                <h1 class="text-2xl font-bold">SOBRE MI</h1>
                <small class="text-lg font-normal">
                  <p class="leading-8">
                    Soy Diego Cubilla, desarrollador Fullstack con un enfoque
                    integral en la creación de productos digitales. Mi
                    experiencia abarca desde el despliegue de aplicaciones web y
                    móviles hasta el desarrollo de sistemas de gestión y
                    extensiones de navegador, cubriendo todo el ciclo de vida de
                    una solución técnica.
                  </p>
                </small>
              </div>
            </div>
          </div>
          <div
            class="flex order-1 lg:order-2 justify-center items-center w-full lg:w-[30%]"
          >
            <div
              class="w-[40%] lg:w-60 flex border bg-[#ddab61] rounded-full shadow-md backdrop-blur-sm shadow-gray-800 overflow-hidden"
            >
              <img
                src="/portfolio/profile.webp"
                class="drop-shadow-lg shadow-amber-800"
                alt="profile"
              />
            </div>
          </div>
        </div>
      </section>
      <div class="w-full relative">
        <section class="mb-5" data-aos="fade-right">
          <section
            class="rounded-xl p-5 bg-gradient-to-r from-[#ddab61] to-[#e09b32] shadow-md shadow-gray-800 text-[#32373b] font-semibold"
            data-aos="zoom-in"
          >
            <div class="my-4 flex gap-x-5 items-center">
              <div>
                <Icon
                  name="mdi:work"
                  class="w-10 h-10 lg:w-20 lg:h-20 text-[#32373b]"
                />
              </div>
              <div>
                <h1 class="text-2xl font-bold">PORTAFOLIO</h1>
                <small class="lg:text-lg text-sm font-normal"
                  >Aqui puede ver los proyectos en los que he trabajado.</small
                >
              </div>
            </div>
            <div class="flex flex-col lg:flex-row h-full gap-2">
              <div
                class="flex gap-2 h-full text-white flex-col justify-center font-semibold"
              >
                <Card />
              </div>
              <div
                class="rounded-lg w-full border-4 overflow-hidden bg-[#f4d6cc] border-[#3e363f] flex-1"
              >
                <Carousel client:load />
              </div>
            </div>
          </section>
        </section>
        <section
          class="rounded-xl p-5 bg-gradient-to-r from-[#ddab61] to-[#e09b32] shadow-md shadow-gray-800 text-[#fff] py-5 h-full"
          data-aos="fade-right"
        >
          <div class="my-4 flex flex-col sm:flex-row w-full sm:justify-between gap-5 items-center">
            <div class="flex gap-x-5 items-center">
              <Icon
                name="mdi:code-braces-box"
                class="w-10 h-10 lg:w-20 lg:h-20 text-[#32373b]"
              />
              <div class="text-[#32373b]">
                <h1 class="text-2xl font-bold">MI STACK</h1>
                <small class="text-sm lg:text-lg font-normal"
                  >Aqui puede ver las tecnologias que manejo.</small
                >
              </div>
            </div>
            <a
              href={`portfolio/CV_DIEGOCUBILLA_2025.pdf`}
              download
              class="project-card group"
            >
              <div
                data-aos="zoom-in"
                class="card-inner
                      relative overflow-hidden
                      h-12 sm:w-20 w-40
                      flex items-center justify-center
                      rounded-lg
                      bg-[#32373b]
                      border-l-8 border-[#c83e4d]
                      text-white
                      transition-colors duration-200"
                >
                <!-- fondo animado -->
                <span
                  class="absolute inset-0
                  bg-[#c83e4d]
                  w-0
                  transition-all duration-300 ease-out
                  group-hover:w-full"
                ></span>

                <!-- contenido -->
                <span
                  class="relative flex flex-row gap-x-2 items-center z-10 text-center"
                >
                  CV <Icon
                    name="mdi:file-download"
                    class="w-8 h-8 text-white"
                  />
                </span>
              </div>
            </a>
          </div>
          <section class="rounded-lg">
            <Backend />
          </section>
        </section>
      </div>
    </div>
  </main>
</Layout>
